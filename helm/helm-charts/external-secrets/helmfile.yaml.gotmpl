bases:
  - repositories.yaml.gotmpl

releases:
  - name: external-secrets
    namespace: external-secrets
    createNamespace: true
    chart: external-secrets/external-secrets
    # Checked via `helm search repo external-secrets/external-secrets` on 2026-08-26.
    version: 2.9.0
    # wait: true - same hazard as aws-load-balancer-controller's release
    # (see its comment): this chart's own webhook (for ExternalSecret/
    # SecretStore validation) needs its pod Ready before the `backend`
    # release later in the list can safely create its ExternalSecret.
    wait: true
    # timeout: 600 - hit live on 2026-08-28: `wait: true`'s default 300s
    # narrowly missed the external-secrets-cert-controller Deployment
    # settling into Ready ("Progress deadline exceeded"), even though
    # kubectl showed it healthy moments after the command gave up.
    # Its own reconcile cycle (--crd-requeue-interval=5m, one of its
    # container args) sits right at that same 300s default with no
    # margin - giving it more room is cheaper than a flaky-looking
    # failure on a future fresh deploy.
    timeout: 600
    values:
      - values.yaml.gotmpl
