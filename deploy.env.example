# Personal deployment configuration - copy this file to deploy.env
# (gitignored - never commit your own values) and fill it in, then:
#
#   source deploy.env
#
# before running anything in docs/DEPLOYMENT.md. Every command in that
# guide, and in scripts/, reads these variables rather than hardcoding
# any one person's AWS profile, GitHub org, or bucket name - so the same
# instructions work whether it's you running them or someone who forked
# these three repos to their own account.

# --- AWS ---
# `aws configure list-profiles` to see what you have configured locally.
export AWS_PROFILE="devops-challenge"
export AWS_REGION="us-east-1"

# --- GitHub ---
# Must match wherever you actually forked/created all three repos -
# golang-gin-realworld-example-app, angular-realworld-example-app, and
# conduit-platform all need to exist under this same org/username.
export GITHUB_ORG="your-github-username"
export BACKEND_REPO="golang-gin-realworld-example-app"
export FRONTEND_REPO="angular-realworld-example-app"
export PLATFORM_REPO="conduit-platform"

# --- Terraform remote state ---
# S3 bucket names are globally unique across every AWS account on
# Earth, not just yours - pick something only you would realistically
# use, or bootstrap will fail with a "bucket already exists" error that
# has nothing to do with permissions.
export TF_STATE_BUCKET="conduit-tfstate-CHANGEME"

# --- Bridges the above into Terraform automatically ---
# TF_VAR_<name> maps directly to var.<name> in terraform/live - no -var
# flags needed on any terraform command in DEPLOYMENT.md.
export TF_VAR_github_org="$GITHUB_ORG"
export TF_VAR_backend_github_repo="$BACKEND_REPO"
export TF_VAR_frontend_github_repo="$FRONTEND_REPO"
export TF_VAR_platform_github_repo="$PLATFORM_REPO"
export TF_VAR_aws_region="$AWS_REGION"
