# image.tag is deliberately not set here - deploy-backend.yml passes it
# via `helmfile apply --set image.tag=<git-sha>`, not a state value.
# State values (what .Values sees in this file) render before CLI
# overrides merge, so `--state-values-set imageTag=...` (the original,
# broken approach) was never actually visible here - see
# docs/design-decisions.md for the live incident this came from.
image:
  repository: {{ .Values.ecrBackendRepositoryUrl }}

replicaCount: {{ .Values.backend.minReplicas }}

autoscaling:
  minReplicas: {{ .Values.backend.minReplicas }}
  maxReplicas: {{ .Values.backend.maxReplicas }}

aws:
  region: {{ .Values.awsRegion }}
  rdsSecretArn: {{ .Values.rdsSecretArn }}
  rdsEndpoint: {{ .Values.rdsEndpoint }}
  rdsDatabaseName: {{ .Values.rdsDatabaseName }}
  redisAddr: "{{ .Values.redisEndpoint }}:6379"
  ssmJwtSecretPath: "/{{ .Values.project }}/{{ .Environment.Name }}/JWT_SECRET"
