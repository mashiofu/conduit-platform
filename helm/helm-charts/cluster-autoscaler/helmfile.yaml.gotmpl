bases:
  - repositories.yaml.gotmpl

releases:
  - name: cluster-autoscaler
    namespace: kube-system
    chart: autoscaler/cluster-autoscaler
    # Checked via `helm search repo autoscaler/cluster-autoscaler` on
    # 2026-08-26 (app v1.35.0). Track this against the EKS Kubernetes
    # version in terraform/live's env_config - cluster-autoscaler's own
    # compatibility policy supports the cluster's minor version +/- a
    # couple, not arbitrary skew.
    version: 9.59.0
    # wait: true for consistency with the other add-on releases in this
    # helmfile (see aws-load-balancer-controller's comment) - this chart
    # doesn't register a cluster-wide admission webhook today, so it
    # isn't gating anything downstream yet, but making every release wait
    # for its own pods keeps that invariant true if that ever changes.
    wait: true
    values:
      - values.yaml.gotmpl
